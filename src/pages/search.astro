---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Search example · Krigsvold baseline"><header slot="hero" class="page-masthead page-masthead--plain"><div class="page-masthead__veil"></div><div class="container"><h1>Search the examples</h1></div></header><div class="page-shell"><div class="container"><article class="editorial-content"><p>Search this intentionally small collection of fictional reference routes.</p><form role="search" action="/search/" method="get"><label for="search-query">Search references</label><input class="site-search-input" id="search-query" type="search" name="q"/><button class="btn btn-dark-blue" type="submit">Search</button></form><div id="search-output" aria-live="polite"><p>Enter a title or subject to filter the reference examples.</p></div></article></div></div><script is:inline>(()=>{const q=new URLSearchParams(location.search).get('q')||'';const field=document.querySelector('#search-query'),out=document.querySelector('#search-output');if(!field||!out)return;field.value=q;const items=[['Article','/article/','field observation research'],['Document','/document/','method documentation'],['Overview','/','compositions layout']].filter(([title,,terms])=>(title+' '+terms).toLowerCase().includes(q.toLowerCase()));if(q.trim()){out.replaceChildren();const p=document.createElement('p');p.textContent=items.length?items.length+' matching reference routes.':'No matching reference routes.';out.append(p);for(const [title,url]of items){const link=document.createElement('a');link.href=url;link.textContent=title;const item=document.createElement('p');item.append(link);out.append(item)}}})();</script></BaseLayout>
