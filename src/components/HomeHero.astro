---
const { page } = Astro.props;
---
    <header class="home-hero" style={page.featured_image ? `background-image: url(${page.featured_image})` : undefined}>
      <div class="home-hero__veil"></div>
      <div class="container home-hero__content">
        <div class="row align-items-center gy-5 gx-4 gx-lg-5">
          <div class="col-lg-7">
            <p class="eyebrow text-white">A field research reference</p>
            <h1>A visual language for real work</h1>
            <p class="home-hero__lede">Field notes, structured records, and documented research provide representative content for a real layout.</p>
            <div class="d-flex flex-wrap gap-3 mt-4">
              <a class="btn btn-ice" href="#the-work">See the work</a>
              <a class="btn btn-outline-light" href={'/article/'}>Read an example</a>
            </div>
          </div>
          <div class="col-lg-5 text-center d-none d-lg-block">
            <div class="home-hero__identity">
              <img class="home-hero__arms" src={'/assets/neutral-mark.svg'} alt="Abstract reference mark" />
              <p class="home-hero__title">
                <span>Northlight</span>
                <span>Field Institute</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </header>
