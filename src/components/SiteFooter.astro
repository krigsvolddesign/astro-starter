---
const settings={footer_menu_settings:{menu_items:[{"title":"Explore","submenu_items":[{"title":"Article","url":"/article/"},{"title":"Document","url":"/document/"}]},{"title":"Examples","submenu_items":[{"title":"Source compositions","url":"/"},{"title":"Search","url":"/search/"}]}]}};
---
<footer class="site-footer"><div class="container"><div class="row gy-5 gx-4 gx-lg-5">
  <div class="col-lg-4"><a class="footer-owner" href="/"><img class="footer-owner__badge" src="/assets/neutral-mark.svg" alt="" width="58" height="58" /><span class="footer-owner__site">Krigsvold reference</span><span class="footer-owner__byline">A content-neutral design specimen</span></a><p class="mt-4">Illustrative publishing, research support, and structured information</p></div>
  {settings.footer_menu_settings.menu_items.map(item => <div class="col-6 col-md-3 col-lg-2"><h2>{item.title}</h2>{item.submenu_items && <ul>{item.submenu_items.map(sub => <li><a href={sub.url} target={sub.target} rel={[sub.relationship,sub.target==='_blank'?'noopener':null].filter(Boolean).join(' ')||undefined} {...Object.fromEntries(Object.entries(sub.data||{}).map(([key,value])=>['data-'+key,value??'']))}>{sub.title}</a></li>)}</ul>}</div>)}
</div><div class="site-footer__base"><p>Reference fixture · {new Date().getUTCFullYear()}</p><p><a href="/article/">Reference article</a></p></div></div></footer>
